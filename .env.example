# =====================================================================
# ClanVox Environment Configuration
# =====================================================================

# Server & Network
PORT=8000
HOST=0.0.0.0
DEBUG=true
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# App Defaults
DEFAULT_LANGUAGE=en
DEFAULT_LOCALE=en-US
FALLBACK_LANGUAGE=en
CONFIDENCE_THRESHOLD_HIGH=0.80
CONFIDENCE_THRESHOLD_LOW=0.50

# LLM Providers (mock, openai, anthropic, gemini)
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FAST_LLM_MODEL=gpt-4o-mini
REASONING_LLM_MODEL=gpt-4o

# STT Providers (mock, deepgram, azure, google, whisper)
STT_PROVIDER=mock
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
GOOGLE_APPLICATION_CREDENTIALS=

# TTS Providers (mock, elevenlabs, cartesia, azure)
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Realtime / WebRTC (LiveKit)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Storage & Caching
DATABASE_URL=sqlite+aiosqlite:///./clanvox.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clanvox
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=super-secret-clanvox-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=60
